# Ambientes e IDE
.venv/
venv/
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Builds desktop
build/
dist/

# Dados brutos baixados (regenerar com scripts/build_data.py)
data/raw/

# Cache de downloads dos scripts de build (GeoNames etc.)
data/cache/

# Imagens pré-baixadas p/ o instalador (regenerar com scripts/build_images.py)
data/processed/images/

# Efemérides JPL (baixadas em tempo de execução para o diretório do usuário)
*.bsp

# Saídas temporárias
*.log
screenshots/

# Documentação INTERNA de desenvolvimento (ADRs, changelog técnico,
# pendências, bugs). Fica só no repositório local por enquanto — a
# documentação pública do software está em docs/.
dev-docs/

# Ícones gerados a partir de assets/ (rode scripts/build_icon.py)
data/processed/icon.ico
data/processed/icon*.png

# Pacotes gerados para publicacao (anexados ao Release, nao versionados)
release/
